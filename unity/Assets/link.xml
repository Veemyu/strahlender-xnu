  <assembly fullname="UnityEngine.PhysicsModule" preserve="all"/>
  <assembly fullname="UnityEngine.ParticleSystemModule" preserve="all"/>
  <!-- Stubs (Stufe stubs): Klassen, die nur über Bundle-Prefabs gebunden werden, referenziert kein Code. -->
  <assembly fullname="Assembly-CSharp" preserve="all"/>
  <assembly fullname="DOTween" preserve="all"/>
  <assembly fullname="DOTweenPro" preserve="all"/>
  <assembly fullname="AssetAssistant" preserve="all"/>
  <assembly fullname="Unity.Polybrush" preserve="all"/>
