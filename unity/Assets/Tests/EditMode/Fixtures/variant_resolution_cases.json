    {"name": "SubShader 1 zählt nicht", "shader": "Test/Sub1", "pass": 0, "keywords": [], "instancing": false,
     "expect": {"file": null, "quality": "unavailable"}},
    {"name": "ForwardAdd-Pass hat Rolle add und keine Umgebung", "shader": "Test/Add", "pass": 0, "keywords": [], "instancing": true,
     "expect": {"file": "Test_Add_s0_p0_a.shader", "quality": "nearest", "role": "add", "ignored": [], "missing": []}},
    {"name": "LightMode schlägt die Keyword-Erkennung", "shader": "Test/Tagged", "pass": 0, "keywords": [], "instancing": false,
