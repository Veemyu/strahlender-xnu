    {"name": "Unlit ohne Keywords", "shader": "Test/Unlit", "pass": 0, "keywords": [], "instancing": false,
     "expect": {"file": "Test_Unlit_s0_p0_a.shader", "quality": "exact", "role": "forward", "ignored": [], "missing": []}},
    {"name": "Unlit mit Keyword", "shader": "Test/Unlit", "pass": 0, "keywords": ["_FLAG"], "instancing": true,
     "expect": {"file": "Test_Unlit_s0_p0_b.shader", "quality": "exact", "role": "forward", "ignored": [], "missing": []}},
    {"name": "Pass ohne Variante", "shader": "Test/Unlit", "pass": 1, "keywords": [], "instancing": false,
     "expect": {"file": null, "quality": "unavailable"}},
    {"name": "nicht verpackbarer Shader", "shader": "Test/Broken", "pass": 0, "keywords": [], "instancing": false,
