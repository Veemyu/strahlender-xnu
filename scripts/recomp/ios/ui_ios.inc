// Window part of the Metal renderer for iOS/iPadOS (replaces everything from the marker "UI thread" of metal.m in metal_ios.m; generated by
// nvn_ios.py). The app (scripts/recomp/ios/app/app.m) creates the CAMetalLayer in the UIView and sets g_ios_layer before the runtime
// starts; input goes through g_ext_buttons/g_ext_stick (nvn_glue.c), the size of the drawing surface is set by the app.
CAMetalLayer *g_ios_layer;

void ui_window_init(void) {
    if (layer) return;
    settings_load();
    layer = g_ios_layer;
    dev = MTLCreateSystemDefaultDevice();
    layer.device = dev;
    layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
    layer.framebufferOnly = getenv("BDSP_WINDOW_SHOT") ? NO : YES;
    LOG("[ios] Metal device %s, BC textures %d, maxBufferLength %llu MiB, recommendedMaxWorkingSetSize %llu MiB\n", dev.name.UTF8String,
        (int)dev.supportsBCTextureCompression, (unsigned long long)(dev.maxBufferLength >> 20),
        (unsigned long long)(dev.recommendedMaxWorkingSetSize >> 20));
    // The game's textures are partly BC1 to BC7; without BC (iPhone A13) metal.m converts them while uploading (bctc.c).
    if (!dev.supportsBCTextureCompression) LOG("[ios] no BC textures on this GPU: BC is converted to ASTC 4x4 / R8 / RG8 while uploading\n");
}

SDL_Window *ui_window(void) { return NULL; }
void *ui_metal_layer(void) { return (__bridge void *)layer; }
void *ui_metal_device(void) { return (__bridge void *)dev; }

int ui_run(void) {
    ui_window_init();
    atomic_store(&ui_ready, true);
    for (;;) {
        if (rt_reboot_requested()) return rt_reboot_requested();
        usleep(16000);
    }
}
