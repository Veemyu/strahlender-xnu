+    int ti = ((int)(st_->bindless_has_sampler ? st_->bindless_sampler_offset : st_->bindless_offset) - (st_->bindless_has_sampler ? 0x168 : 0x568)) / 8;
     uint64_t th = (ti >= 0 && ti < 32) ? st.tex[stage][ti] : 0;
