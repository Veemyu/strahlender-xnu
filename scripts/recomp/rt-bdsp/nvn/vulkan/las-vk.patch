+// BDSP (Unity) reads texture handles bindlessly from the driver's constant buffer 2: two tables of 8-byte words, one from
+// 0x168 and one from 0x568 (BindSeparateTexture / BindSeparateSampler, same index per unit); the combined handle is the OR.
+static uint64_t shader_handle(int stage, const ShaderTexture *st_) {
+    if (!st_->bindless) {
+        int slot = ((int)st_->handle_offset - 0x20) / 8;  // 64-bit handles from offset 0x20
+        return (slot >= 0 && slot < 32) ? st.tex[stage][slot] : 0;
+    }
+    int ti = ((int)st_->bindless_offset - 0x568) / 8;
+    // With two words the table at 0x168 holds the TEXTURE handles and the one at 0x568 the sampler handles (Unity binds
+    // texture and sampler of a unit with the same index; shaders whose compiler gave texture and sampler different
+    // table indices - 24 % of the fragment programs - show it, e.g. TextMeshPro SDF text).
+    if (st_->bindless_has_sampler) ti = ((int)st_->bindless_sampler_offset - 0x168) / 8;
+    uint64_t th = (ti >= 0 && ti < 32) ? st.tex[stage][ti] : 0;
+    if (!th) return 0;
+    uint64_t sh = 0;
+    if (st_->bindless_has_sampler) {
+        int si = ((int)st_->bindless_offset - 0x568) / 8;
+        sh = (si >= 0 && si < 32) ? st.smp[stage][si] : 0;
+    }
+    return (th & 0xFFFFF) | (sh & 0xFFF00000ull);
+}
 
